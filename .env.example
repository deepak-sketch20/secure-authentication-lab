# Copy to .env only if you load it with your chosen environment tool.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Set COOKIE_SECURE=1 when serving over HTTPS. Keep 0 for localhost HTTP testing.
COOKIE_SECURE=0
# Optional shared rate-limit store for multi-worker deployment:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
